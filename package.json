{
  "name": "ha-person-card",
  "version": "1.0.0",
  "description": "A modern custom Lovelace person card for Home Assistant featuring dynamic state images and associated entities.",
  "main": "dist/ha-person-card.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/ha-person-card.ts --bundle --outfile=dist/ha-person-card.js --target=es2020 --format=esm --minify",
    "build:dev": "esbuild src/ha-person-card.ts --bundle --outfile=dist/ha-person-card.js --target=es2020 --format=esm",
    "watch": "esbuild src/ha-person-card.ts --bundle --outfile=dist/ha-person-card.js --target=es2020 --format=esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "person-card"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "happy-dom": "^20.11.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
